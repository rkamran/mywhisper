<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MyWhisper</AssemblyName>
    <RootNamespace>MyWhisper</RootNamespace>
    <Version>1.0.4</Version>
    <Product>MyWhisper</Product>
    <Description>Push-to-talk dictation for Windows, powered by Whisper.</Description>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <!--
      PublishSingleFile is intentionally OFF. With it on, .NET extracts the
      bundled native DLLs (whisper.dll, ggml*.dll) to a per-launch temp
      directory under runtimes/<rid>/. NativeLibrary.Load then uses
      LOAD_WITH_ALTERED_SEARCH_PATH which searches whisper.dll's own folder
      first for its dependencies (VCRUNTIME140.dll etc.) — and they're not
      there, they're next to MyWhisper.exe in the install dir. The load fails
      with "Cannot load the library on this platform using NativeLibrary."

      With single-file off the publish output is a normal folder where
      MyWhisper.exe, whisper.dll, ggml*.dll, and the VC++ runtime DLLs all
      live side by side at standard NuGet runtime paths, so the loader's
      probe works the way the package expects. Inno Setup still bundles the
      whole folder into a single setup.exe — recipient UX is unchanged.
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <Authors>MyWhisper</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Speech-to-text: whisper.cpp wrapped for .NET. Runtime package ships the
         native CPU library; swap to Whisper.net.Runtime.Cublas for NVIDIA GPUs. -->
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />

    <!-- Audio capture (WASAPI) + resampling. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- System tray icon for WPF. -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />

    <!-- DPAPI for at-rest encryption of the polish API key. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- System.Drawing.Icon for tray icon loading (the Hardcodet IconSource path
         renders blank for PNG-compressed multi-resolution .ico files). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the app icon as a WPF Resource so it's loadable from the assembly
         even when published as a single file. The ApplicationIcon directive
         above still handles the .exe's file icon shown in Explorer. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
