<Window x:Class="MyWhisper.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyWhisper.Views"
        Title="MyWhisper"
        Width="580" Height="640"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="#FFEAEAEA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <views:DictationStatusConverter x:Key="DictationStatus" />
        <BooleanToVisibilityConverter x:Key="StdBoolToVis" />

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="StepDesc">
            <Setter Property="Foreground" Value="#FFA0A0A0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1A1A1A" />
            <Setter Property="Foreground" Value="#FFEAEAEA" />
            <Setter Property="BorderBrush" Value="#FF4A4A4A" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,4,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,12">
            <TextBlock Text="🎙" FontSize="30" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MyWhisper" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Hold Right Alt to dictate anywhere."
                           Foreground="#FFA0A0A0" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- Steps -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
            <StackPanel>

                <!-- Step 1: Whisper model -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepTitle}"
                                   Text="1 · Whisper model (ggml-base.en, ~141 MB)" />
                        <TextBlock Style="{StaticResource StepDesc}"
                                   Text="Downloads once to %LOCALAPPDATA%\MyWhisper. Runs locally — no audio leaves your PC." />

                        <!-- Not downloaded -->
                        <StackPanel Visibility="{Binding ModelDownloaded, Converter={StaticResource InvBoolToVis}}">
                            <Button x:Name="DownloadButton" Content="Download model"
                                    Click="OnDownloadModel" HorizontalAlignment="Left" />
                            <ProgressBar Height="6" Margin="0,8,0,2"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding ModelDownloadProgress, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Downloaded -->
                        <TextBlock Text="✓ Model ready" Foreground="#FF5FD068" FontWeight="SemiBold"
                                   Visibility="{Binding ModelDownloaded, Converter={StaticResource StdBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Step 2: Input device -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepTitle}" Text="2 · Microphone" />
                        <TextBlock Style="{StaticResource StepDesc}"
                                   Text="Pick the capture device MyWhisper should record from. Leave unset to follow the Windows default input device." />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="DeviceCombo" Width="300"
                                      ItemsSource="{Binding AvailableInputDevices}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedInputDeviceId, Mode=TwoWay}" />
                            <Button Content="↻" ToolTip="Refresh device list"
                                    Click="OnRefreshDevices" Margin="8,0,0,0" />
                            <Button Content="Use system default" Click="OnUseSystemDefault" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3: Polish -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepTitle}" Text="3 · Polish transcripts (optional)" />
                        <TextBlock Style="{StaticResource StepDesc}"
                                   Text="Send the raw transcript to an OpenAI-compatible chat endpoint (Ollama Cloud by default) to fix punctuation and infer list/heading formatting. Falls back to the raw transcript if unconfigured or unreachable." />

                        <CheckBox x:Name="PolishToggle" Content="Polish transcripts before typing"
                                  IsChecked="{Binding PolishEnabled, Mode=TwoWay}" Margin="0,0,0,8" />

                        <StackPanel Visibility="{Binding PolishEnabled, Converter={StaticResource StdBoolToVis}}">
                            <TextBlock Text="Endpoint" Foreground="#FFA0A0A0" Margin="0,4,0,0" />
                            <TextBox Text="{Binding PolishEndpoint, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Text="Model" Foreground="#FFA0A0A0" Margin="0,8,0,0" />
                            <TextBox Text="{Binding PolishModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Text="API key" Foreground="#FFA0A0A0" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <PasswordBox x:Name="ApiKeyBox" Width="320"
                                             Background="#FF1A1A1A" Foreground="#FFEAEAEA"
                                             BorderBrush="#FF4A4A4A" Padding="6,4" Margin="0,2" />
                                <Button Content="Save" Click="OnSaveApiKey" />
                                <Button Content="Remove" Click="OnRemoveApiKey"
                                        Visibility="{Binding PolishApiKeyPresent, Converter={StaticResource StdBoolToVis}}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#FF808080"
                                       Text="The key is encrypted with Windows DPAPI (per-user) in %LOCALAPPDATA%\MyWhisper." />
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#FF5FD068"
                                       Text="✓ API key stored"
                                       Visibility="{Binding PolishApiKeyPresent, Converter={StaticResource StdBoolToVis}}" />

                            <Border Margin="0,10,0,0" Padding="8" CornerRadius="6" Background="#FF202020"
                                    Visibility="{Binding PolishApiKeyPresent, Converter={StaticResource StdBoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Last raw:" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding LastRawTranscript}" FontSize="11"
                                               Foreground="#FFA0A0A0" TextWrapping="Wrap" />
                                    <TextBlock Text="Last polished:" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LastTranscript}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ready card -->
                <Border Style="{StaticResource Card}" Background="#FF1F3320" BorderBrush="#FF2F5F32"
                        Visibility="{Binding IsFullyConfigured, Converter={StaticResource StdBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="✓ Ready to dictate" FontWeight="SemiBold"
                                   Foreground="#FF5FD068" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#FFC8C8C8"
                                   Text="Place your cursor in any text field, hold the Right Alt key, speak, and release. Your words are typed in." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF161616" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="#FF909090" FontSize="12"
                           Text="{Binding Dictation, Converter={StaticResource DictationStatus}}" />
                <TextBlock Text="  ·  " Foreground="#FF606060" VerticalAlignment="Center" />
                <Button Content="Microphone privacy settings" Click="OnOpenMicSettings"
                        Padding="8,3" FontSize="11" Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
